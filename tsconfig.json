{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "allowJs": true, "checkJs": false,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "baseUrl": ".", "paths": {"@/*": ["web/shared/*"]}
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"],
  "exclude": ["node_modules"]
}
